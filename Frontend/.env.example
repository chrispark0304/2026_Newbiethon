# .env.local 로 복사해서 값을 채우세요. (.env.local 은 gitignore 됩니다)
#
#   cp Frontend/.env.example Frontend/.env.local
#
# 값을 바꾸면 Vite를 재시작해야 반영됩니다. HMR로는 안 잡힙니다.

# 카카오맵 JavaScript 키 — 지도 타일과 장소검색 자동완성에 쓴다.
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# ※ 백엔드(api/.env)의 REST API 키와는 다른 키다.
#
# ⚠️ 카카오 콘솔 > 플랫폼 > Web > 사이트 도메인에 개발 주소가 등록돼 있어야 한다.
#    현재 등록: http://localhost:8443
#    그래서 Vite를 8443으로 띄워야 지도가 뜬다:
#        npx vite --port 8443 --host localhost
#    127.0.0.1 은 localhost 와 다른 도메인으로 취급되니 주의.
VITE_KAKAO_JS_KEY=

# 백엔드 주소. 생략하면 http://127.0.0.1:8000 을 쓴다.
# 팀원 머신에서 백엔드를 안 띄우고 다른 사람 것을 쓸 때만 바꾸면 된다.
VITE_API_BASE=http://127.0.0.1:8000
