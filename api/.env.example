# api/.env 로 복사해서 값을 채우세요. (api/.env 는 gitignore 됩니다)
#
#   cp api/.env.example api/.env
#
# 카카오 REST API 키 — 대중교통 경로 조회 + 주소 지오코딩에 쓴다.
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키
# ※ 프론트(Frontend/.env.local)의 JavaScript 키와는 다른 키다.
KAKAO_REST_API_KEY=2a6c321504cc2b495e13ed16242d27ac

# 대중교통 경로 조회 일일 호출 상한. 카카오 쿼터가 1,000건이라 여유를 둔다.
KAKAO_DAILY_BUDGET=900

# 통근시간 출처: hybrid(기본) | engine | kakao
COMMUTE_PROVIDER=hybrid

# 매물 원본 CSV 경로 (비워두면 서울 전역본)
# LISTINGS_CSV=rtms_같이살집_최종_202608.csv
